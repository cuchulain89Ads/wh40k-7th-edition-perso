    <profile name="Illum Flare" id="5432a591-fd7c-6c71-0e92-cc376dea1774" hidden="false" page="6" profileTypeId="72c5eafc-75bf-4ed9-b425-78009f1efe82">
      <characteristics>
        <characteristic name="Description" characteristicTypeId="21befb24-fc85-4f52-a745-64b2e48f8228" value="During each friendly Movement phase, a model equipped with illum flares may drop one as though it were a weapon with the Bomb 1 type, placing a marker where the flare lands. All units within 12&quot; of the Flare marker may be targeted as though Night Fight was not in effect. Illum flares have no effect if the Night Fight rules are not in play. At the end of each Game Turn, remove all Flare markers currently on the battlefield."/>
      </characteristics>
    </profile>
