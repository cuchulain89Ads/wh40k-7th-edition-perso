    <rule name="Stomp" id="702de286-c480-b115-bf5e-e46c5761e747" hidden="false" page="0"/>
    <rule name="Subterranean Assault" id="2bf61d27-7e32-53a8-0129-7f1dbc480c6c" hidden="false" page="218"/>
    <rule name="Subterranean Barrage" id="0cbf55b0-d8de-e095-7fbf-6ff99bf1843a" hidden="false" page="203"/>
    <rule name="Summary Execution" id="e3493339-64c4-881d-a4e4-dfae745232e1" hidden="false" page="208">
      <description>If a unit that includes a model with this special rule fails a Fear test, Morale check or Pinning test, the controlling player may choose to remove one model from the unit as a casualty, with no saves of any kind allowed, in order to have the unit pass the test. If the controlling player chooses to remove a model, roll a D6. On a 3+, the controlling player chooses which model is removed. On a 1 or 2, the opposing player chooses. Note that a model with this special rule may never be chosen as the model to be removed.</description>
    </rule>
